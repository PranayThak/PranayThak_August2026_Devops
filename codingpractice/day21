

1) Ansible : install nginx & start enable service. 


--- 

- name: Install and configure nginx
  hosts: all
  become: yes


  tasks:
     
     -name: install nginx
      ansible.builtin.package:
        name: nginx
        state: present
     
      -name: start and enable nginx 
       ansible.builtin.package:
         name: nginx
	 state: started
	 enabled: yes


