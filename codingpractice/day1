pipeline {
     agent any 
     stages {
          stage ( 'checkout' ) {
	     steps {
	          git branch : 'main' , url: 'https://github.com/pathnex/sample-java-app.git'
		  }
	}

	stage ('list files') {
	steps {
	     sh 'ls -la'
	     }
