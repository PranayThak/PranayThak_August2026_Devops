## Terraform Task - Create EC2 (c5.xlarge)



provider "aws"{
region = "us-east-1"
}


resource "aws_instance" "PAthnexEC2" {
ami = "ami-0abcd123abcd187"
instance_type ="c5.xlarge"
tags = {
name ="pathnex-ec2"
       }
}









## Kubernetes Task - Create Nginx Pod 


apiVersion : v1
kind : pod 
metadata :
  name : pathnex-pod
spec :
  containers :
  - name : web
  image : nginx:latest
  ports :
  - containerPort : 80





